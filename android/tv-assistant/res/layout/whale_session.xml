<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent voice-interaction overlay: the app behind keeps playing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/whale_session_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/whale_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/session_scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="56dp"
        android:layout_marginBottom="36dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- big circular controls above the composer, sized for D-pad focus -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/whale_again"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/btn_close"
                android:contentDescription="Send / ask another question"
                android:focusable="true"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/whale_close"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginLeft="14dp"
                android:background="@drawable/btn_close"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="17dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Speech bubble: accent rule + three-line content -->
        <LinearLayout
            android:layout_width="660dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bubble"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_marginLeft="0dp"
                android:background="@drawable/accent_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="30dp"
                android:paddingRight="34dp"
                android:paddingTop="20dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/whale_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginRight="9dp"
                        android:background="@drawable/dot_accent" />

                    <TextView
                        android:id="@+id/whale_eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.16"
                        android:text="LISTENING"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assistant"
                        android:textColor="@color/muted_foreground"
                        android:textSize="11sp" />

                    <ImageButton
                        android:id="@+id/whale_send"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginLeft="10dp"
                        android:background="@drawable/btn_close"
                        android:contentDescription="Send"
                        android:focusable="true"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_send"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/whale_you"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:textColor="#C9D6E8"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/whale_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="7"
                    android:textColor="@color/foreground"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pet with a soft ground shadow -->
        <FrameLayout
            android:layout_width="210dp"
            android:layout_height="195dp"
            android:layout_gravity="end"
            android:layout_marginTop="-8dp">

            <View
                android:layout_width="160dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="5dp"
                android:background="@drawable/pet_shadow" />

            <ImageView
                android:id="@+id/whale_art"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="bottom|center_horizontal"
                android:scaleType="fitCenter"
                android:contentDescription="Powered by Whale-chan"
                android:src="@drawable/ic_whale" />
        </FrameLayout>
    </LinearLayout>



    <TextView
        android:id="@+id/whale_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="18dp"
        android:text="@string/credit"
        android:textColor="#66FFFFFF"
        android:textSize="11sp" />
</FrameLayout>
