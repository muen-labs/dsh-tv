<?xml version="1.0" encoding="utf-8"?>
<!-- Bridge home: 1920x1080 design / 2 = 960x540dp. 152px gutters -> 76dp,
     two columns 1.12fr/.88fr with a 34px (17dp) gap, glass cards over the
     exported ambient glow background. Padding is the design gutter PLUS the
     title-safe inset (76+12dp horiz, 27+8dp vert) so HDMI/projector overscan
     cannot crop the left card edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bridge_ambient"
    android:orientation="vertical"
    android:paddingLeft="@dimen/bridge_pad_h"
    android:paddingRight="@dimen/bridge_pad_h"
    android:paddingTop="@dimen/bridge_pad_v"
    android:paddingBottom="@dimen/bridge_pad_v">

    <!-- ============ topbar: lockup + status badges ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:background="@drawable/logo_tile"
            android:contentDescription="DeepSeek TV Assistant"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Shadcn.Wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DeepSeek " />

                <TextView
                    style="@style/Shadcn.WordmarkStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV Assistant" />
            </LinearLayout>

            <TextView
                style="@style/Shadcn.Tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:text="Press the Disney+ button and talk" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/status_badge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/badge_h"
            android:background="@drawable/pill_success"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/badge_pad"
            android:paddingRight="@dimen/badge_pad">

            <View
                android:id="@+id/status_dot"
                android:layout_width="@dimen/dot"
                android:layout_height="@dimen/dot"
                android:layout_marginRight="4dp"
                android:background="@drawable/dot_on" />

            <TextView
                android:id="@+id/status_text"
                style="@style/Shadcn.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUNNING · 2h 14m"
                android:textColor="@color/success" />
        </LinearLayout>

        <TextView
            android:id="@+id/version_pill"
            style="@style/Shadcn.Badge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/badge_h"
            android:layout_marginLeft="5dp"
            android:background="@drawable/pill_plain"
            android:gravity="center"
            android:paddingLeft="@dimen/badge_pad"
            android:paddingRight="@dimen/badge_pad"
            android:text="v2.0" />
    </LinearLayout>

    <!-- ============ two-column body ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap_row"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- left column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.12"
            android:orientation="vertical">

            <!-- Get started / Connect this TV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="@dimen/card_pad">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Shadcn.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GET STARTED" />

                        <TextView
                            style="@style/Shadcn.H2Card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Connect this TV" />
                    </LinearLayout>

                    <TextView
                        style="@style/Shadcn.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/badge_h"
                        android:background="@drawable/pill_plain"
                        android:gravity="center"
                        android:paddingLeft="@dimen/badge_pad"
                        android:paddingRight="@dimen/badge_pad"
                        android:text="2 min" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_pair"
                    style="@style/Shadcn.Button.Tint"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:drawableStart="@drawable/ic_tv_pair"
                    android:drawablePadding="5dp"
                    android:text="Pair this TV with your Mac" />

                <TextView
                    style="@style/Shadcn.MutedBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Shows a QR code — scan it with your phone to connect this TV to DSH." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/sep_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_stop"
                        style="@style/Shadcn.Button.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="2.5dp"
                        android:drawableStart="@drawable/ic_stop"
                        android:drawablePadding="5dp"
                        android:text="Stop service" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="11dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_accessibility"
                                android:layout_width="@dimen/disc"
                                android:layout_height="@dimen/disc"
                                android:background="@drawable/btn_circle"
                                android:contentDescription="Accessibility settings"
                                android:focusable="true"
                                android:padding="10dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_accessibility" />

                            <TextView
                                style="@style/Shadcn.Caption"
                                android:layout_width="48dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_horizontal"
                                android:maxLines="1"
                                android:maxWidth="41dp"
                                android:text="Accessibility" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="9dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_mic"
                                android:layout_width="@dimen/disc"
                                android:layout_height="@dimen/disc"
                                android:background="@drawable/btn_circle"
                                android:contentDescription="Grant microphone"
                                android:focusable="true"
                                android:padding="10dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_mic_round" />

                            <TextView
                                style="@style/Shadcn.Caption"
                                android:layout_width="48dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_horizontal"
                                android:maxLines="1"
                                android:maxWidth="41dp"
                                android:text="Microphone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="9dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/btn_refresh"
                                android:layout_width="@dimen/disc"
                                android:layout_height="@dimen/disc"
                                android:background="@drawable/btn_circle"
                                android:contentDescription="Refresh status"
                                android:focusable="true"
                                android:padding="10dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_refresh" />

                            <TextView
                                style="@style/Shadcn.Caption"
                                android:layout_width="48dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_horizontal"
                                android:maxLines="1"
                                android:text="Refresh" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Live / Service status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/gap_row"
                android:layout_weight="1"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="@dimen/card_pad">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="11dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Shadcn.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE" />

                        <TextView
                            style="@style/Shadcn.H2Card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Service status" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/healthy_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/badge_h"
                        android:background="@drawable/pill_success"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="@dimen/badge_pad"
                        android:paddingRight="@dimen/badge_pad">

                        <View
                            android:id="@+id/healthy_dot"
                            android:layout_width="@dimen/dot"
                            android:layout_height="@dimen/dot"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/dot_on" />

                        <TextView
                            android:id="@+id/healthy_text"
                            style="@style/Shadcn.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Healthy"
                            android:textColor="@color/success" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Shadcn.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ADDRESS" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/value_address"
                                style="@style/Shadcn.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="192.168.4.58" />

                            <TextView
                                android:id="@+id/value_port"
                                style="@style/Shadcn.ValueSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="2dp"
                                android:text=": 8765" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Shadcn.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MICROPHONE" />

                        <TextView
                            android:id="@+id/value_mic"
                            style="@style/Shadcn.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Granted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Shadcn.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACCESSIBILITY" />

                        <TextView
                            android:id="@+id/value_accessibility"
                            style="@style/Shadcn.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Connected" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Shadcn.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FOREGROUND" />

                        <TextView
                            android:id="@+id/value_foreground"
                            style="@style/Shadcn.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="7.5dp"
                            android:text="com.jp.dshtv" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Shadcn.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPTIME" />

                        <TextView
                            android:id="@+id/value_uptime"
                            style="@style/Shadcn.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="2h 14m" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Shadcn.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VERSION" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/value_version"
                                style="@style/Shadcn.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2.0" />

                            <TextView
                                android:id="@+id/value_version_note"
                                style="@style/Shadcn.ValueSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="4dp"
                                android:text="· debug" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Shadcn.Fine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TV Assistant pane · DSH on Mac mini" />

                    <LinearLayout
                        android:id="@+id/connected_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/badge_h"
                        android:background="@drawable/pill_success"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="@dimen/badge_pad"
                        android:paddingRight="@dimen/badge_pad">

                        <View
                            android:id="@+id/connected_dot"
                            android:layout_width="@dimen/dot"
                            android:layout_height="@dimen/dot"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/dot_on" />

                        <TextView
                            android:id="@+id/connected_text"
                            style="@style/Shadcn.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONNECTED"
                            android:textColor="@color/success" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- right column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/gap_col"
            android:layout_weight="0.88"
            android:orientation="vertical">

            <!-- First-time setup / Four steps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="@dimen/card_pad">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Shadcn.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIRST-TIME SETUP" />

                    <TextView
                        style="@style/Shadcn.H2Card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Four steps" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Shadcn.StepNum"
                        android:layout_width="@dimen/step_num"
                        android:layout_height="@dimen/step_num"
                        android:background="@drawable/step_num"
                        android:gravity="center"
                        android:text="1" />

                    <TextView
                        android:id="@+id/step_text_1"
                        style="@style/Shadcn.StepText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:layout_weight="1"
                        android:text="Enable DSH TV Bridge in Accessibility settings." />
                </LinearLayout>

                <TextView
                    style="@style/Shadcn.StepSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:layout_marginTop="0dp"
                    android:text="Settings → Device Preferences → Accessibility" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Shadcn.StepNum"
                        android:layout_width="@dimen/step_num"
                        android:layout_height="@dimen/step_num"
                        android:background="@drawable/step_num"
                        android:gravity="center"
                        android:text="2" />

                    <TextView
                        android:id="@+id/step_text_2"
                        style="@style/Shadcn.StepText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:layout_weight="1"
                        android:text="Grant the microphone." />
                </LinearLayout>

                <TextView
                    style="@style/Shadcn.StepSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:layout_marginTop="0dp"
                    android:text="Used for the voice assistant only" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Shadcn.StepNum"
                        android:layout_width="@dimen/step_num"
                        android:layout_height="@dimen/step_num"
                        android:background="@drawable/step_num"
                        android:gravity="center"
                        android:text="3" />

                    <TextView
                        android:id="@+id/step_text_3"
                        style="@style/Shadcn.StepText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:layout_weight="1"
                        android:text="Pair with your Mac." />
                </LinearLayout>

                <TextView
                    style="@style/Shadcn.StepSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:layout_marginTop="0dp"
                    android:text="Scan the QR, approve on your phone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Shadcn.StepNum"
                        android:layout_width="@dimen/step_num"
                        android:layout_height="@dimen/step_num"
                        android:background="@drawable/step_num"
                        android:gravity="center"
                        android:text="4" />

                    <TextView
                        android:id="@+id/step_text_4"
                        style="@style/Shadcn.StepText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:layout_weight="1"
                        android:text="Press Disney+ and talk." />
                </LinearLayout>

                <TextView
                    style="@style/Shadcn.StepSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="22dp"
                    android:layout_marginTop="0dp"
                    android:text="OK sends, Back cancels" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/sep_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/code_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/code_chip_pad_h"
                    android:paddingTop="@dimen/code_chip_pad_v"
                    android:paddingRight="@dimen/code_chip_pad_h"
                    android:paddingBottom="@dimen/code_chip_pad_v">

                    <TextView
                        style="@style/Shadcn.MutedBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Check from the Mac" />

                    <TextView
                        android:id="@+id/code_curl"
                        style="@style/Shadcn.MonoChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="curl 192.168.4.58:8765/ping" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_pair_second"
                        style="@style/Shadcn.Button.Dark"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:drawableStart="@drawable/ic_tv_pair"
                        android:drawablePadding="5dp"
                        android:text="Pair another TV" />

                    <Button
                        android:id="@+id/btn_test_mic"
                        style="@style/Shadcn.Button.Dark"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginLeft="6dp"
                        android:drawableStart="@drawable/ic_mic_small"
                        android:drawablePadding="5dp"
                        android:text="Test the mic" />
                </LinearLayout>
            </LinearLayout>

            <!-- Paired with -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_row"
                android:background="@drawable/card_glass"
                android:orientation="vertical"
                android:padding="@dimen/card_pad">

                <TextView
                    style="@style/Shadcn.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="PAIRED WITH" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="9dp"
                        android:contentDescription="Mac mini"
                        android:src="@drawable/ic_laptop" />

                    <TextView
                        style="@style/Shadcn.StepText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:text="Mac mini" />

                    <TextView
                        style="@style/Shadcn.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DSH" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="9dp"
                        android:contentDescription="Living Room TV"
                        android:src="@drawable/ic_tv" />

                    <TextView
                        android:id="@+id/paired_tv_name"
                        style="@style/Shadcn.StepText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="Living Room TV" />

                    <TextView
                        style="@style/Shadcn.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Projectivy" />
                </LinearLayout>

                <TextView
                    style="@style/Shadcn.Fine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="LAN only · ports 8765 and 8766 stay inside your home network." />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ footer credit ============ -->
