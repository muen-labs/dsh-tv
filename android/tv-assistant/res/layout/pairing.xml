<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pair this TV with Whale-chan"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pair_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scan the QR with your phone to approve this TV."
            android:textColor="#9FB3C8"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/pair_qr"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/pair_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#7FD3FF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/pair_ip"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:hint="Mac mini IP"
                android:textColor="#FFFFFF"
                android:textColorHint="#607080"
                android:inputType="textUri"
                android:singleLine="true"
                android:textSize="18sp" />

            <Button
                android:id="@+id/pair_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="Pair"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
