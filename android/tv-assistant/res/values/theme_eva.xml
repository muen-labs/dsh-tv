<?xml version="1.0" encoding="utf-8"?>
<!--
  Design tokens: shadcn/ui semantic names mapped onto the Eva Design System
  dark theme (@eva-design/eva, UI Kitten dark.json) + the 10-foot "glass"
  tokens from docs/ui-mockup.html.

  SCALE CONTRACT: the mockup stage is 1920x1080 design px; the TV app canvas is
  960x540dp (wm size 1920x1080 @ density 320). dp = design px / 2,
  sp = design px / 2. So 152px gutters -> 76dp, 20px card radius -> 10dp,
  34px H1 -> 17sp, 58px pairing hero -> 29sp, 16px body -> 8sp,
  11.5px label -> 5.75sp, 56px control -> 28dp, 2px focus ring -> 2dp.
-->
<resources>
