<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="WhaleTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorBackground">@android:color/transparent</item>
    </style>

    <!--
      shadcn typography primitives at the 10-foot scale (design px / 2).
      The mockup uses a geometric sans; the box only ships Roboto, so the
      closest system families are sans-serif / sans-serif-medium /
      sans-serif-black, and monospace for anything the design sets in mono.
    -->
    <style name="Shadcn" parent="@android:style/TextAppearance" />
    <style name="Shadcn.Text" parent="@android:style/TextAppearance" />

    <!-- 58px hero (pairing) -->
    <style name="Shadcn.Hero">
        <item name="android:textSize">29dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- 34px H1 -->
    <style name="Shadcn.H1">
        <item name="android:textSize">17dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- 21px H2, 18px inside cards -->
    <style name="Shadcn.H2">
        <item name="android:textSize">10.5dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Shadcn.H2Card">
        <item name="android:textSize">9dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- 16px sub / body -->
    <style name="Shadcn.Sub">
        <item name="android:textSize">8dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Shadcn.Body">
        <item name="android:textSize">8dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Shadcn.BodyMedium">
        <item name="android:textSize">8dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <!-- 14px muted, 13.5px muted body, 12.5px fine print -->
    <style name="Shadcn.Muted">
        <item name="android:textSize">7dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
    </style>
    <style name="Shadcn.MutedBody">
        <item name="android:textSize">6.75dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>
    <style name="Shadcn.Fine">
        <item name="android:textSize">6.25dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
    </style>
    <!-- 11.5px uppercase label -->
    <style name="Shadcn.Label">
        <item name="android:textSize">5.75dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- 14px mono -->
    <style name="Shadcn.Mono">
        <item name="android:textSize">7dp</item>
        <item name="android:textColor">@color/primary_hover</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Shadcn.MonoChip">
        <item name="android:textSize">6.5dp</item>
        <item name="android:textColor">@color/primary_hover</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <!-- kv value 17px / small 13px -->
    <style name="Shadcn.Value">
        <item name="android:textSize">8.5dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Shadcn.ValueSmall">
        <item name="android:textSize">6.5dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
    </style>
    <!-- brand lockup 22px wordmark / 12px tagline -->
    <style name="Shadcn.Wordmark">
        <item name="android:textSize">11dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Shadcn.WordmarkStrong">
        <item name="android:textSize">11dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Shadcn.Tagline">
        <item name="android:textSize">6dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
    </style>
    <!-- 12px badge / 12px foot -->
    <style name="Shadcn.Badge">
        <item name="android:textSize">6dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Shadcn.Foot">
        <item name="android:textSize">6dp</item>
        <item name="android:textColor">@color/dim_text</item>
    </style>
    <!-- 15px step text / 13px small -->
    <style name="Shadcn.StepText">
        <item name="android:textSize">7.5dp</item>
        <item name="android:textColor">@color/foreground</item>
    </style>
    <style name="Shadcn.StepSmall">
        <item name="android:textSize">6.5dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
    </style>
    <style name="Shadcn.StepNum">
        <item name="android:textSize">6.5dp</item>
        <item name="android:textColor">@color/primary_hover</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Shadcn.Caption">
        <item name="android:textSize">5.75dp</item>
        <item name="android:textColor">@color/muted_foreground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">0.5dp</item>
    </style>

    <!-- buttons: 16px / 56px min height / 10px radius (tint+dark+danger: 14px) -->
    <style name="Shadcn.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/primary_foreground</item>
        <item name="android:textSize">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">@dimen/btn_pad_h</item>
        <item name="android:paddingRight">@dimen/btn_pad_h</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">5dp</item>
    </style>
    <style name="Shadcn.Button.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/secondary_foreground</item>
    </style>
    <style name="Shadcn.Button.Outline">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/foreground</item>
    </style>
    <style name="Shadcn.Button.Destructive">
        <item name="android:background">@drawable/btn_destructive</item>
        <item name="android:textColor">@color/primary_foreground</item>
    </style>
    <style name="Shadcn.Button.Tint">
        <item name="android:background">@drawable/btn_tint</item>
        <item name="android:textColor">@color/tint_text</item>
        <item name="android:textSize">8dp</item>
    </style>
    <style name="Shadcn.Button.Dark">
        <item name="android:background">@drawable/btn_dark</item>
        <item name="android:textColor">@color/foreground</item>
    </style>
    <style name="Shadcn.Button.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/danger_text</item>
    </style>

    <!-- assistant overlay copy -->
    <style name="Shadcn.Eyebrow">
        <item name="android:textSize">5.75dp</item>
        <item name="android:textColor">@color/primary_hover</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Shadcn.Heard">
        <item name="android:textSize">10dp</item>
        <item name="android:textColor">@color/heard_text</item>
        <item name="android:textStyle">italic</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>
    <style name="Shadcn.Say">
        <item name="android:textSize">12.5dp</item>
        <item name="android:textColor">@color/foreground</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Shadcn.ChipKey">
        <item name="android:textSize">5.5dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
