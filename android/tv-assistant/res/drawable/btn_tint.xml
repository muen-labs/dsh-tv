<?xml version="1.0" encoding="utf-8"?>
<!-- .btn.tint: primary at ~16% with a 55% primary border, 14px radius. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tint_fill_hover" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_active" />
            <corners android:radius="@dimen/radius_btn" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/tint_fill" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="1dp" android:color="@color/tint_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tint_fill" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="1dp" android:color="@color/tint_border" />
        </shape>
    </item>
</selector>
