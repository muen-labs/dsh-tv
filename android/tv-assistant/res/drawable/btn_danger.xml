<?xml version="1.0" encoding="utf-8"?>
<!-- .btn.danger: destructive at ~14% with a 52% destructive border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_fill_hover" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_fill_hover" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="1dp" android:color="@color/danger_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_fill" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="1dp" android:color="@color/danger_border" />
        </shape>
    </item>
</selector>
