<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A598BFF" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" /><corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</selector>
