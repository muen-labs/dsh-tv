<?xml version="1.0" encoding="utf-8"?>
<!-- Mockup bridge card: translucent navy fill over the ambient glows, 1px
     white-16 border and a top rim light (linear-gradient 180deg). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_rim_hi"
                android:centerColor="@color/glass_rim_lo"
                android:endColor="@color/glass_rim_none" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</layer-list>
