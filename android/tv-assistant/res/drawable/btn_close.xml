<?xml version="1.0" encoding="utf-8"?>
<!-- 38px send disc + 64px overlay discs: dark with a focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/dark_btn_hover" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/dark_btn_pressed" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/dark_btn" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</selector>
