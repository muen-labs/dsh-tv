<?xml version="1.0" encoding="utf-8"?>
<!-- Modal scrim: ~66% black base + a soft vignette + a bottom gradient so the
     composer always reads, even over a bright frame. Shown over the captured
     blurred backdrop when that is available (real blur fallback). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A8060A12" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.45"
                android:gradientRadius="900dp"
                android:startColor="#00000000"
                android:centerColor="#1A000000"
                android:endColor="#66000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#33000000"
                android:endColor="#A6000000" />
        </shape>
    </item>
</layer-list>
