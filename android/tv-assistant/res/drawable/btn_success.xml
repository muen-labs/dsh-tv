<?xml version="1.0" encoding="utf-8"?>
<!-- .btn.success: success at ~14% fill with a 50% success border, 7dp radius.
     Mirrors .btn.danger so the service toggle reads green when stopped and
     red when running, with the same 2dp focus ring in both states. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/success_btn_fill_hover" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/ring" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/success_btn_fill_hover" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="1dp" android:color="@color/success_btn_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/success_btn_fill" />
            <corners android:radius="@dimen/radius_btn" />
            <stroke android:width="1dp" android:color="@color/success_btn_border" />
        </shape>
    </item>
</selector>
