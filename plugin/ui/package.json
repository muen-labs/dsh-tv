{
  "name": "dsh-whale-chan-tv",
  "version": "0.2.0",
  "description": "DSH settings pane + pairing for the DeepSeek TV Android TV assistant",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "preview": "node tools/preview.mjs --png",
    "verify": "node tools/verify.mjs && node tools/verify-host.mjs",
    "verify:ui": "node tools/verify.mjs",
    "verify:host": "node tools/verify-host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "author": "thuyqpham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thuyqpham/dsh-tv.git",
    "directory": "plugin/ui"
  },
  "homepage": "https://github.com/thuyqpham/dsh-tv#readme",
  "bugs": {
    "url": "https://github.com/thuyqpham/dsh-tv/issues"
  }
}
